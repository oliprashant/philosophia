# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Railway, Neon, etc.)
DATABASE_URL=postgresql://user:password@host:5432/philosophia?schema=public

# ─── Firebase Auth (client only) ──────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=philosophia-1e39c.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=philosophia-1e39c
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=philosophia-1e39c.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=905651730003
NEXT_PUBLIC_FIREBASE_APP_ID=1:905651730003:web:1c679a6961fdbfdeb8a6
NEXT_PUBLIC_SITE_URL=https://blogs.oliprashant.com.np

# Firebase Admin SDK is not used in the client-only setup.
# Keep these here only if you need them for a separate backend service.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Supabase (password reset only) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Instagram (via Facebook): https://developers.facebook.com/
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# ─── Groq (free) ──────────────────────────────────────────────────────────────
# https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Analytics ────────────────────────────────────────────────────────────────
# Plausible.io data domain (e.g. philosophia.blog)
PLAUSIBLE_DATA_DOMAIN=

# Google Analytics Measurement ID (e.g. G-XXXXXXXXXX)
GOOGLE_ANALYTICS_ID=

# ─── Email / Newsletter ───────────────────────────────────────────────────────
# Mailchimp API key and Audience List ID
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# SMTP settings for transactional email (e.g. Resend, SendGrid, or your own)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_...
SMTP_FROM=noreply@philosophia.blog
