# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Railway, Neon, etc.)
DATABASE_URL=postgresql://user:password@host:5432/philosophia?schema=public

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# ─── OAuth Providers ──────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=0v23li6loJ0R3OZYJLUx
GITHUB_CLIENT_SECRET=ac55dd8d1aaaa5a77978957031c2810f71e30ccb

# ─── Supabase (password reset only) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Instagram (via Facebook): https://developers.facebook.com/
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# ─── Groq (free) ──────────────────────────────────────────────────────────────
# https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Analytics ────────────────────────────────────────────────────────────────
# Plausible.io data domain (e.g. philosophia.blog)
PLAUSIBLE_DATA_DOMAIN=

# Google Analytics Measurement ID (e.g. G-XXXXXXXXXX)
GOOGLE_ANALYTICS_ID=

# ─── Email / Newsletter ───────────────────────────────────────────────────────
# Mailchimp API key and Audience List ID
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# SMTP settings for transactional email (e.g. Resend, SendGrid, or your own)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_...
SMTP_FROM=noreply@philosophia.blog
